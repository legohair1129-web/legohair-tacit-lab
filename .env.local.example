# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard, or `supabase status` for local dev).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_. Used by admin staff creation
# (src/lib/supabase/admin.ts). Get it from Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
